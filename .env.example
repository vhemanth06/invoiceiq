GEMINI_API_KEY=your_key_here          # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-flash-latest      # pick a current free-tier Flash model in AI Studio
GROQ_API_KEY=your_key_here            # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b        # confirm on console.groq.com/docs/models
LLM_PROVIDER_ORDER=gemini,groq,ollama,sample_truth
OLLAMA_MODEL=llama3.2-vision          # optional, local
OLLAMA_URL=http://localhost:11434
USE_LLM_CACHE=true                    # replay cached extractions (demo safety)
USE_LLM_EXPLANATIONS=true             # false = template explanations only
